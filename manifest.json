{
  "manifest_version": 3,
  "name": "EshaalTab — New Tab & Bookmark Boards",
  "version": "2.0.52",
  "description": "A new tab built around your own boards: pin the links you use, save any page in one click, search everything with Ctrl+K.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Quick Save to EshaalTab",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "js/extension/background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "bookmarks",
    "tabs",
    "favicon",
    "history",
    "contextMenus"
  ],
  "commands": {
    "save-current-tab": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Save the current page to EshaalTab Inbox"
    }
  }
}
